# jai-proxy configuration.
#
#   cp .env.template .env      # .env is git-ignored; edit it, don't edit this
#
# Read at startup by proxy/config.py (Settings) -- by the server, by every
# script under scripts/, and by the test suite. Precedence is: real environment
# variable > .env > the default shown here. Every key is optional; commented-out
# lines below are the defaults.
#
# List values are parsed as JSON, e.g. JAI_PROXY_USER_NAMES=["USER","Matt"].


# --- Where cards live -------------------------------------------------------

# The card archive. Point this at SillyTavern's characters folder to make
# SillyTavern the archive itself -- a card edited or deleted there simply is the
# archive's new state, no sync step, no second copy to reconcile.
#JAI_PROXY_OUTPUT_DIR=./cards
#JAI_PROXY_OUTPUT_DIR=/Users/you/workspaces/SillyTavern/data/default-user/characters

# flat   -- <name>_<id8>.png, one directory. Required by SillyTavern: it does
#           not recurse into subfolders.
# nested -- <creator>/<name>_<id8>.png, the original layout. The creator is on
#           the card either way (extensions.jai.creatorName), and the id
#           fragment keeps filenames unique, so flat loses nothing.
#JAI_PROXY_CARD_LAYOUT=flat

# Server working state -- hidden-definition captures and the lorebook cache.
# Kept out of the cards folder on purpose: that may be SillyTavern's directory.
#JAI_PROXY_CAPTURES_DIR=./state/captures
#JAI_PROXY_LOREBOOK_CACHE_DIR=./state/lorecache


# --- Server -----------------------------------------------------------------

#JAI_PROXY_HOST=127.0.0.1
#JAI_PROXY_PORT=8000
#JAI_PROXY_REQUEST_TIMEOUT=120.0
#JAI_PROXY_ALLOWED_ORIGINS=["*"]


# --- Card building ----------------------------------------------------------

# Persona names reversed back to {{user}} in captured prose. Add whatever names
# you actually chat under on JanitorAI / saucepan.
#JAI_PROXY_USER_NAMES=["USER"]

# Lossily quantize avatars with pngquant before embedding. Fails soft when the
# binary is missing.
#JAI_PROXY_COMPRESS=true
#JAI_PROXY_PNGQUANT_BIN=./proxy/pngquant


# --- Local model (used for the definition-capture assist) -------------------

#JAI_PROXY_MLX_BASE_URL=http://127.0.0.1:8011/v1
#JAI_PROXY_MLX_MODEL=Llama-3.2-3B-Instruct-4bit


# --- Outbound proxy ----------------------------------------------------------

# Routes server-initiated calls to third-party APIs (currently just the
# datacat.run original-avatar lookup in `make import --fetch-datacat-images`)
# through an HTTP(S) proxy. Leave unset to call directly.
#JAI_PROXY_HTTP_PROXY=http://127.0.0.1:8080

# datacat.run anonymous session token. Left unset the first time -- the
# resolver fetches one and writes this key back into your .env itself, so
# later runs reuse it instead of re-hitting the identify endpoint. No need to
# set this by hand.
#JAI_PROXY_DATACAT_SESSION_TOKEN=

# --- Terminal output ---------------------------------------------------------

# The live dashboard (log column + downloads column). On by default whenever
# the server runs in a terminal; set false to always use plain logging.
#JAI_PROXY_DASHBOARD=false
